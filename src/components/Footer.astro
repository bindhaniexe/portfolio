---
/**
 * Footer.astro — Footer_Section
 *
 * Renders a semantic <footer> with three contact/social links:
 * - A GitHub profile link (Requirement 8.1)
 * - A LinkedIn profile link (Requirement 8.2)
 * - A mailto: email link that delegates to the visitor's default email
 *   client when activated (Requirements 8.3, 8.4)
 *
 * The links use placeholder URLs/email and will be updated with real
 * details before deployment. The `mailto:` scheme is applied even on the
 * placeholder so the delegation behavior is always correct.
 *
 * Styling follows the dark monochromatic theme (neutral scale + accent
 * token). Interactive links display an accent color on hover and include
 * `focus-visible` ring states for keyboard accessibility.
 *
 * Requirements: 8.1, 8.2, 8.3, 8.4, 3.1
 */
---

<footer
  class="w-full border-t border-neutral-800 bg-neutral-950 px-6 py-12 sm:px-8"
  aria-label="Site footer"
>
  <div class="mx-auto flex w-full max-w-6xl flex-col items-center gap-6 sm:flex-row sm:justify-between">

    <!-- Brand / identity mark -->
    <p class="text-sm text-neutral-500">
      &copy; {new Date().getFullYear()} — Full-Stack Engineer &amp; 3D Visualizer
    </p>

    <!-- Social and contact links -->
    <nav aria-label="Contact and social links">
      <ul class="flex items-center gap-6">

        <!-- GitHub profile link — Requirement 8.1 -->
        <li>
          <a
            href="https://github.com/username"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="GitHub profile"
            class="flex items-center gap-2 text-sm font-medium text-neutral-400 transition-colors duration-200 hover:text-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-neutral-950"
          >
            <!-- GitHub icon (SVG) -->
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
            >
              <path
                d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"
              />
            </svg>
            GitHub
          </a>
        </li>

        <!-- LinkedIn profile link — Requirement 8.2 -->
        <li>
          <a
            href="https://linkedin.com/in/username"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="LinkedIn profile"
            class="flex items-center gap-2 text-sm font-medium text-neutral-400 transition-colors duration-200 hover:text-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-neutral-950"
          >
            <!-- LinkedIn icon (SVG) -->
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
            >
              <path
                d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
              />
            </svg>
            LinkedIn
          </a>
        </li>

        <!-- Email link via mailto: scheme — Requirements 8.3, 8.4 -->
        <li>
          <a
            href="mailto:email@example.com"
            aria-label="Send email"
            class="flex items-center gap-2 text-sm font-medium text-neutral-400 transition-colors duration-200 hover:text-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-neutral-950"
          >
            <!-- Email icon (SVG) -->
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <rect width="20" height="16" x="2" y="4" rx="2" />
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
            </svg>
            Email
          </a>
        </li>

      </ul>
    </nav>
  </div>
</footer>
