---
/**
 * Skills.astro — Tech Stack & Skills section.
 *
 * Renders the section heading and description, then mounts the
 * SkillsGallery React island (client:load) which drives the
 * CircularGallery OGL/WebGL carousel showing tech logos + names.
 *
 * Requirements: 5.1, 5.2, 5.3, 5.4, 5.5, 3.1, 3.2, 3.3, 3.4
 */
import SkillsGallery from "./SkillsGallery";
---

<section
  id="skills"
  aria-labelledby="skills-heading"
  class="w-full py-20 md:py-28 overflow-hidden"
>
  <!-- Heading block — contained within max-width wrapper -->
  <div class="mx-auto w-full max-w-6xl px-6">
    <h2
      id="skills-heading"
      class="text-3xl font-bold tracking-tight text-neutral-50 md:text-4xl"
    >
      Tech Stack &amp; Skills
    </h2>
    <p class="mt-3 max-w-2xl text-neutral-400">
      Drag, scroll, or use arrow keys to explore the languages, frameworks,
      and tools I work with across full-stack engineering.
    </p>
  </div>

  <!-- Full-width CircularGallery carousel (no max-width cap) -->
  <div class="mt-10 w-full">
    <SkillsGallery client:load />
  </div>
</section>
