---
/**
 * Skills.astro — the Tech Stack & Skills section.
 *
 * Renders a semantic <section> that maps over the static `skillCategories`
 * data into four category groups (Languages, Frameworks & Libraries,
 * Tools & Platforms, Design). Each category lists its skills using a
 * pill-based list layout (rounded-full badges styled with the neutral
 * scale and accent theme tokens).
 *
 * The layout is mobile-first: a single-column base grid that expands to a
 * multi-column grid at the `md` breakpoint and above.
 *
 * Requirements: 5.1, 5.2, 5.3, 5.4, 5.5, 3.1, 3.2, 3.3, 3.4
 */
import { skillCategories } from "../data/skills";
---

<section id="skills" aria-labelledby="skills-heading" class="mx-auto w-full max-w-6xl px-6 py-20 md:py-28">
  <h2 id="skills-heading" class="text-3xl font-bold tracking-tight text-neutral-50 md:text-4xl">
    Tech Stack &amp; Skills
  </h2>
  <p class="mt-3 max-w-2xl text-neutral-400">
    A scannable overview of the languages, frameworks, and tools I work
    with across full-stack engineering.
  </p>

  <!-- Mobile-first: single column base, multi-column at md and lg breakpoints -->
  <div class="mt-12 grid grid-cols-1 gap-8 md:grid-cols-2">
    {
      skillCategories.map((category) => (
        <div class="rounded-2xl border border-neutral-800 bg-neutral-900 p-6">
          <h3 class="text-lg font-semibold text-neutral-100">{category.name}</h3>
          <ul class="mt-4 flex flex-wrap gap-2">
            {category.skills.map((skill) => (
              <li class="rounded-full border border-neutral-700 bg-neutral-800 px-3 py-1 text-sm text-neutral-200 transition-colors hover:border-accent hover:text-accent">
                {skill}
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</section>
