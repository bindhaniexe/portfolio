---
/**
 * Projects.astro — the Engineering Projects section.
 *
 * Renders a semantic <section id="projects"> with an interactive folder
 * gallery (React + Framer Motion) as the hero presentation, followed by
 * the full project card grid for detailed browsing.
 *
 * Requirements: 6.1, 6.2, 3.1, 3.2, 3.3, 3.4
 */
import { projects } from "../data/projects";
import { InteractiveFolderGallery } from "./ui/interactive-folder-gallery";

// Map projects to GalleryPhoto format with matching Unsplash covers
const galleryPhotos = [
  {
    id: 1,
    image: "https://images.unsplash.com/photo-1512941937669-90a1b58e7e9c?q=80&w=800&auto=format&fit=crop",
    title: projects[0].title,
    description: projects[0].description,
    tech: projects[0].tech,
    githubUrl: projects[0].githubUrl,
    demoUrl: projects[0].demoUrl,
  },
  {
    id: 2,
    image: "https://images.unsplash.com/photo-1498050108023-c5249f4df085?q=80&w=800&auto=format&fit=crop",
    title: projects[1].title,
    description: projects[1].description,
    tech: projects[1].tech,
    githubUrl: projects[1].githubUrl,
    demoUrl: projects[1].demoUrl,
  },
  {
    id: 3,
    image: "https://images.unsplash.com/photo-1556742049-0cfed4f6a45d?q=80&w=800&auto=format&fit=crop",
    title: projects[2].title,
    description: projects[2].description,
    tech: projects[2].tech,
    githubUrl: projects[2].githubUrl,
    demoUrl: projects[2].demoUrl,
  },
  {
    id: 4,
    image: "https://images.unsplash.com/photo-1593508512255-86ab42a8e620?q=80&w=800&auto=format&fit=crop",
    title: projects[3].title,
    description: projects[3].description,
    tech: projects[3].tech,
    githubUrl: projects[3].githubUrl,
    demoUrl: projects[3].demoUrl,
  },
];
---

<section
  id="projects"
  aria-labelledby="projects-heading"
  class="w-full bg-neutral-950 px-6 py-20 md:py-28"
>
  <div class="mx-auto max-w-6xl">
    <h2
      id="projects-heading"
      class="text-3xl font-bold tracking-tight text-neutral-50 md:text-4xl"
    >
      Engineering Projects
    </h2>
    <p class="mt-3 max-w-2xl text-neutral-400">
      A selection of full-stack, mobile, and systems projects showcasing
      architecture decisions, technology choices, and engineering depth.
    </p>

    <!-- Interactive folder gallery (React island, client:load for interactivity) -->
    <div class="mt-12">
      <InteractiveFolderGallery
        client:load
        photos={galleryPhotos}
        folderName="Engineering.projects"
        dragHintText="Drag any card down to close"
      />
    </div>

  </div>
</section>
