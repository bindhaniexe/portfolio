---
/**
 * Projects.astro — the Engineering Projects section.
 *
 * Renders a semantic <section id="projects"> (the anchor target for the
 * Hero "View Engineering Projects" CTA). Maps over the static `projects`
 * data array into a responsive card grid: single-column on mobile,
 * two-column at the md breakpoint, using one <ProjectCard> per project.
 *
 * Requirements: 6.1, 6.2, 3.1, 3.2, 3.3, 3.4
 */
import { projects } from "../data/projects";
import ProjectCard from "./ProjectCard.astro";
---

<section
  id="projects"
  aria-labelledby="projects-heading"
  class="mx-auto w-full max-w-6xl px-6 py-20 md:py-28"
>
  <h2
    id="projects-heading"
    class="text-3xl font-bold tracking-tight text-neutral-50 md:text-4xl"
  >
    Engineering Projects
  </h2>
  <p class="mt-3 max-w-2xl text-neutral-400">
    A selection of full-stack, mobile, and systems projects showcasing
    architecture decisions, technology choices, and engineering depth.
  </p>

  <!-- Mobile-first: single column base, two-column at md breakpoint -->
  <div class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-2">
    {projects.map((project) => <ProjectCard {...project} />)}
  </div>
</section>
