---
/**
 * Layout.astro — the shared document shell for the portfolio.
 *
 * Provides the complete HTML scaffold (`<html>`, `<head>`, `<body>`),
 * responsive viewport metadata, the document title, an optional meta
 * description, the global stylesheet, and a `<slot />` into which pages
 * inject their content.
 *
 * Requirements: 1.1, 1.2, 1.3, 1.4, 1.5
 */
import "../styles/global.css";

interface LayoutProps {
  /** Document title rendered in <title>. */
  title: string;
  /** Optional meta description for the document <head>. */
  description?: string;
}

const { title, description } = Astro.props as LayoutProps;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {description && <meta name="description" content={description} />}
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-neutral-950 text-neutral-50 antialiased">
    <slot />
  </body>
</html>
